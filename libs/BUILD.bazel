    name = "telemetry",
    srcs = ["telemetry.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//modal",
        "@pypi//opentelemetry_api",
        "@pypi//opentelemetry_exporter_otlp_proto_common",
        "@pypi//opentelemetry_exporter_otlp_proto_http",
        "@pypi//opentelemetry_sdk",
        "@pypi//opentelemetry_semantic_conventions",
    ],
)
