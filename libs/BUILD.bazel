filegroup(
    name = "architecture_sources",
    srcs = glob(["*.py"]),
    visibility = ["//tests/architecture:__pkg__"],
)

py_library(
    name = "__init__",
    srcs = ["__init__.py"],
    visibility = ["//:__subpackages__"],
)

