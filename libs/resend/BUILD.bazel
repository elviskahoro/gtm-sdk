load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# gazelle:python_generation_mode project

# keep
filegroup(
    name = "architecture_sources",
    srcs = glob(["**/*.py"]),
    visibility = ["//tests/architecture:__pkg__"],
)

py_binary(
    name = "email",
    srcs = ["email.py"],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//pydantic",
        "@pypi//resend",
    ],
)

py_library(
    name = "resend",
    srcs = [
        "__init__.py",
        "email.py",
    ],
    visibility = ["//:__subpackages__"],
    deps = [
        "@pypi//pydantic",
        "@pypi//resend",
    ],
)
