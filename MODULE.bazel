module(
    name = "gtm_sdk",
    version = "0.1.0",
)

bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(
    name = "gazelle",
    version = "0.51.3",
    repo_name = "bazel_gazelle",
)
bazel_dep(name = "rules_python_gazelle_plugin", version = "2.2.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.13.13")
python.toolchain(python_version = "3.13.13")
use_repo(python, "python_3_13_13")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.13.13",
    requirements_lock = "//:requirements_bazel.txt",
)
use_repo(pip, "pypi")
